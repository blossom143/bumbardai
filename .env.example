# Use a URL-safe value if changing the local PostgreSQL password.
POSTGRES_PASSWORD=hallway_local
APP_BIND=127.0.0.1
APP_PORT=3000
# Set when serving behind a local HTTPS reverse proxy.
PUBLIC_ORIGIN=
TRUST_PROXY=false

# Assistant provider. The guided demo also works without a model credential.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set AI_PROVIDER=ollama and choose a downloaded local chat model.
# Leave the URL blank to use the host default for Docker or native development.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Optional basic browser push and OTLP tracing.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
